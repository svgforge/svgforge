{
  "name": "@svgforge/svgforge",
  "version": "4.0.0",
  "author": "svgforge (https://github.com/SpotlightOn)",
  "contributors": [
    "Joschi Kuphal <joschi@kuphal.net> (https://jkphl.is)"
  ],
  "description": "SVG icon stack builder — A low-level Node.js module + cli that takes a collection of SVG files, optimizes them, and assembles them into reusable icon assets with matching stylesheet resources.",
  "homepage": "https://github.com/svgforge/svgforge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgforge/svgforge.git"
  },
  "bugs": {
    "url": "https://github.com/svgforge/svgforge/issues"
  },
  "license": "MIT",
  "keywords": [
    "icon",
    "icons",
    "svg",
    "png",
    "sprite",
    "spritesheet",
    "stack",
    "generator",
    "css",
    "stylesheet",
    "inline",
    "html",
    "vector",
    "rwd",
    "retina",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "svgforge": "./bin/svgforge.js"
  },
  "main": "lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./utils": {
      "types": "./types/utils.d.ts",
      "default": "./lib/svgforge/utils/index.js"
    },
    "./lib/svg-sprite/utils/index.js": {
      "types": "./types/utils.d.ts",
      "default": "./lib/svgforge/utils/index.js"
    }
  },
  "files": [
    "bin",
    "lib",
    "tmpl",
    "types"
  ],
  "scripts": {
    "lint": "xo",
    "fix": "xo --fix",
    "example": "node example.js",
    "test": "node --test",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='lib/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "test:watch": "node --test --watch"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "css-selector-parser": "^3.3.0",
    "css-tree": "^3.2.1",
    "csso": "^5.0.5",
    "js-yaml": "^5.5.0",
    "svgo": "^4.1.0",
    "ventojs": "^2.4.2",
    "yargs": "^18.2.0"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint-plugin-jsdoc": "^65.5.1",
    "pixelmatch": "^8.0.0",
    "playwright-chromium": "^1.65.1",
    "pngjs": "^7.0.0",
    "xo": "^5.0.1"
  }
}
