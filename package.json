{
  "name": "svgforge",
  "version": "1.0.0",
  "author": "Felix Müller",
  "contributors": [
    "Joschi Kuphal <joschi@kuphal.net> (https://jkphl.is)"
  ],
  "description": "SVG sprites & stacks galore — A low-level Node.js module that takes a bunch of SVG files, optimizes them and bakes them into SVG sprites of several types along with suitable stylesheet resources (e.g. CSS, Sass, etc.)",
  "homepage": "https://github.com/svgforge/svgforge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgforge/svgforge.git"
  },
  "bugs": {
    "url": "https://github.com/svgforge/svgforge/issues"
  },
  "license": "MIT",
  "keywords": [
    "icon",
    "icons",
    "svg",
    "png",
    "sprite",
    "spritesheet",
    "stack",
    "generator",
    "css",
    "stylesheet",
    "inline",
    "html",
    "vector",
    "rwd",
    "retina",
    "mustache"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "main": "lib/svg-sprite.js",
  "files": [
    "lib",
    "tmpl"
  ],
  "scripts": {
    "lint": "xo",
    "fix": "xo --fix",
    "example": "node example.js",
    "test": "node --test",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "test:watch": "node --test --watch"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "css-selector-parser": "^3.3.0",
    "csso": "^5.0.5",
    "cssom": "^0.5.0",
    "import-lazy": "^4.0.0",
    "js-yaml": "^5.4.1",
    "lodash.escape": "^4.0.1",
    "lodash.merge": "^4.6.2",
    "mustache": "^4.2.0",
    "prettysize": "^2.0.0",
    "svgo": "^4.1.0",
    "vinyl": "^3.0.1",
    "winston": "^3.19.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "eslint-plugin-jsdoc": "^64.3.2",
    "pixelmatch": "^7.2.0",
    "playwright-chromium": "^1.50.1",
    "pngjs": "^7.0.0",
    "xo": "^4.0.0"
  }
}
