<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>SVG &lt;symbol&gt; sprite preview | svg-sprite</title>
    <link href="{{ css |> safe }}" rel="stylesheet">
    <style>
      body {
        padding: 0;
        margin: 0;
        color: #666;
        background: #fafafa;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        line-height: 1.4;
        width: 1280px;
      }
      ol {
        margin: 0;
        padding: 0;
      }
      li {
        display: inline-block;
        background-color: #fff;
        position: relative;
        margin: 14px;
        vertical-align: middle;
        border: 1px solid #ccc;
        padding: 13px;
        cursor: default;
        width: 200px;
        height: 200px;
        line-height: 200px;
      }
      figure {
        width: 100%;
        margin: 0;
        padding: 0;
        text-align: center;
        display: inline-block;
        line-height: 1;
        vertical-align: middle;
      }
      figcaption {
        display: none;
      }
    </style>
  </head>
  <body>
    {{ svg |> safe }}
    <ol>
      {{ for s of shapes }}<li>
        <figure>
          <svg class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}"><use href="#{{ s.name }}"/></svg>
          <figcaption>{{ s.name }}</figcaption>
        </figure>
      </li>{{ /for }}
    </ol>
  </body>
</html>
