<!doctype html>
{{ import { figcaption } from "figcaption.vto" }}{{ import { footer } from "footer.vto" }}
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>SVG &lt;view&gt; sprite preview | svgforge</title>

<!--
Common preview styles (shared via tmpl/common/preview.css)
====================================================================================================
-->

    <style>
    {{ include "preview-css" }}
    </style>

  </head>
  <body>
    <header>
      <h1>SVG <code>&lt;view&gt;</code> sprite preview</h1>
      <p>This preview features the use of the generated sprite by referencing the pre-defined <code>&lt;view&gt;</code> elements (fragment identifiers). Please have a look at the HTML source for further details and be aware of the following constraints:</p>
      <ul class="grid">
        <li>Your browser has to <a href="https://caniuse.com/svg-fragment" target="_blank" rel="noopener noreferrer">support SVG fragment identifiers</a> for SVG stacks to work.</li>
        <li></li>
      </ul>
    </header>
    <section>

<!--
External sprite with pre-defined views referenced by fragment identifiers
====================================================================================================
These SVG images make use of fragment identifiers (IDs) and are referencing the <view> elements
pre-defined in the external sprite.
-->

      <h3>External sprite with pre-defined views referenced by fragment identifiers</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <img src="{{ example |> safe }}#{{ s.name }}" class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}" alt="{{ s.name }}">
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>

    </section>
    {{ footer() }}

<!--
Common preview behavior (shared via tmpl/common/preview.js)
====================================================================================================
-->

<script>
{{ include "preview-js" }}
</script>
  </body>
</html>
