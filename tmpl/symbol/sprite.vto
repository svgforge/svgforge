<!doctype html>
{{ import { figcaption } from "figcaption.vto" }}{{ import { footer } from "footer.vto" }}
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>SVG &lt;symbol&gt; sprite preview | svg-sprite</title>

    <style>
    {{ include "preview-css" }}
    </style>

  </head>
  <body>

{{ if inline }}
<!--
Inline <symbol> SVG sprite
====================================================================================================
This is an inlined version of the generated SVG sprite. The single images may be <use>d everywhere
below within this document. Please see

  https://github.com/svgforge/svgforge/blob/main/docs/configuration.md#defs--symbol-mode

for further details on how to create this embeddable sprite variant.
-->

<svg width="0" height="0" style="position:absolute">
{{ for s of shapes }}
  {{ s.svg |> safe }}
{{ /for }}
</svg>
{{ /if }}

    <header>
      <h1>SVG <code>&lt;symbol&gt;</code> sprite preview</h1>
{{ if inline }}
      <p>This preview features the use of the generated sprite as inline SVG based on the embedded sprite below. Please have a look at the HTML source for further details and be aware of the following constraints:</p>
      <ul class="grid">
        <li>Your browser has to <a href="https://caniuse.com/svg-html5" target="_blank" rel="noopener noreferrer">support inline SVG</a> for these techniques to work.</li>
        <li>The embedded sprite (A) slightly differs from the generated external one. Please <a href="https://github.com/svgforge/svgforge/blob/main/docs/configuration.md#defs--symbol-mode" target="_blank" rel="noopener noreferrer">see the documentation</a> for details on how to create such an embeddable sprite.</li>
      </ul>
{{ /if }}
{{ if !inline }}
      <p>This preview features the use of the generated sprite as an external SVG spritemap. Please have a look at the HTML source for further details and be aware of the following constraints:</p>
      <ul class="grid">
        <li>Your browser has to <a href="https://caniuse.com/svg-html5" target="_blank" rel="noopener noreferrer">support inline SVG</a> for these techniques to work.</li>
      </ul>
{{ /if }}
    </header>
    <section>
{{ if inline }}

<!--
A) Inline SVG with embedded sprite
====================================================================================================
These SVG images make use of fragment identifiers (IDs) and are extracted out of the inline sprite
embedded above. They may be styled via CSS.
-->

      <h3>A) Inline SVG with embedded sprite</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <svg class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}">
                <use href="#{{ s.name }}"></use>
              </svg>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>
{{ /if }}
    </section>
    <section>
{{ if !inline }}

<!--
B) Inline SVG with external sprite
====================================================================================================
These SVG images make use of an URL + fragment identifiers (IDs) and refer to the regular external
SVG sprite. They may be styled via CSS.
-->

      <h3>B) Inline SVG with external sprite</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <svg class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}">
                <use href="{{ example |> safe }}#{{ s.name }}"></use>
              </svg>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>
{{ /if }}
    </section>
    <section>

<!--
C) Inline SVG, sized by viewBox only (stacksvg-style)
====================================================================================================
This method needs no CSS at all: the SVG is sized by a single `width` (or `height`) attribute and the
missing other dimension is derived from the shape's viewBox — the same technique the
[stacksvg](https://github.com/stacksvg/stacksvg) project relies on.
-->

      <h3>C) Inline SVG, sized by viewBox only (stacksvg-style)</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <svg viewBox="0 0 {{ s.width.outer }} {{ s.height.outer }}" width="1.5em">
                <use href="{{ if inline }}#{{ s.name }}{{ /if }}{{ if !inline }}{{ example |> safe }}#{{ s.name }}{{ /if }}"></use>
              </svg>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>

    </section>
    {{ footer() }}

<!--
Common preview behavior (shared via tmpl/common/preview.js)
====================================================================================================
-->

<script>
{{ include "preview-js" }}
</script>
  </body>
</html>
