<!doctype html>
{{ import { figcaption } from "figcaption.vto" }}{{ import { footer } from "footer.vto" }}
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>SVG stack preview | svg-sprite</title>

    <style>
    {{ include "preview-css" }}
    </style>

  </head>
  <body>
{{ if inline }}
<!--
Inline SVG stack
====================================================================================================
This is an inlined version of the generated SVG stack. The single images may be <use>d everywhere
below within this document. Please see

  https://github.com/svgforge/svgforge/blob/main/docs/configuration.md#stack-mode

for further details on how to create this embeddable sprite variant.
-->

<svg width="0" height="0" style="position:absolute">
{{ for s of shapes }}
  {{ s.svg |> safe }}
{{ /for }}
</svg>
{{ /if }}
    <header>
      <h1>SVG stack preview</h1>
      <p>This preview features an SVG stack. Please have a look at the HTML source for further details and be aware of the following constraints:</p>
      <ul class="grid">
        <li>Your browser has to <a href="https://caniuse.com/svg-fragment" target="_blank" rel="noopener noreferrer">support SVG fragment identifiers</a> for SVG stacks to work.</li>
        <li></li>
      </ul>
    </header>
    <section>

<!--
SVG stack
====================================================================================================
These SVG images make use of fragment identifiers (IDs) to reference certain portions of the
external sprite. By default, all shapes inside the sprite are hidden by CSS. The `:target` pseudo
selector is used to show the very shape that is referenced by the fragment identifier.
-->

      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <img src="{{ example |> safe }}#{{ s.name }}" class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}" alt="{{ s.name }}">
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>

<!--
====================================================================================================
-->

      <h3>B) Inline SVG, sized by viewBox only (stacksvg-style)</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <svg viewBox="0 0 {{ s.width.outer }} {{ s.height.outer }}" width="1.5em">
                <use href="{{ if inline }}#{{ s.name }}{{ /if }}{{ if !inline }}{{ example |> safe }}#{{ s.name }}{{ /if }}"></use>
              </svg>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>

<!--
C) Sprite as CSS background image (inline style)
====================================================================================================
The stack sprite may also be used as a CSS background image. The fragment identifier (`#id`) selects
the section to show, just like with `<img>` before. The `:target` pseudo selector reveals the
referenced shape. This variant only works with the stack mode — the other modes don't expose their
shapes this way. Note the `background-repeat: no-repeat` and the `-dims` class that provides the
shape dimensions.
-->

      <h3>C) Sprite as CSS background image (inline style)</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <div class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}" style="background-image: url('{{ example |> safe }}#{{ s.name }}');"></div>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>

    </section>
    {{ footer() }}

<!--
Common preview behavior (shared via tmpl/common/preview.js)
====================================================================================================
-->

<script>
{{ include "preview-js" }}
</script>
  </body>
</html>
