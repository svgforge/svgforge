{{ import { figcaption } from "figcaption.vto" }}{{ layout "layout.vto" }}
{{ slot docTitle }}SVG stack preview | svgforge{{ /slot }}
{{ slot header }}<h1>SVG stack preview ({{ if it.inline }}inline{{ else }}external{{ /if }})</h1>
      <p>This preview features an SVG stack. Please have a look at the HTML source for further details and be aware of the following constraints:</p>{{ /slot }}
{{ slot hints }}<li>Your browser has to <a href="https://caniuse.com/svg-fragment" target="_blank" rel="noopener noreferrer">support SVG fragment identifiers</a> for SVG stacks to work.</li>{{ /slot }}
{{ slot embedded }}
<!--
Inline SVG stack
====================================================================================================
This is an inlined version of the generated SVG stack. The single images may be <use>d everywhere
below within this document. Please see

  https://github.com/svgforge/svgforge/blob/main/docs/configuration.md#stack-mode

for further details on how to create this embeddable sprite variant.
-->

<svg width="0" height="0" style="position:absolute">
{{ for s of shapes }}
  {{ s.svg |> safe }}
{{ /for }}
</svg>
{{ /slot }}
    <section>

<!--
SVG stack
====================================================================================================
These SVG images make use of fragment identifiers (IDs) to reference certain portions of the
external sprite. By default, all shapes inside the sprite are hidden by CSS. The `:target` pseudo
selector is used to show the very shape that is referenced by the fragment identifier.
-->

      <h3>SVG stack</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <img src="{{ example |> safe }}#{{ s.name }}" class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}" alt="{{ s.name }}">
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>

<!--
{{ if it.inline }}Inline {{ /if }}SVG, sized by viewBox only (stacksvg-style)
====================================================================================================
This method needs no CSS at all: the SVG is sized by a single `width` (or `height`) attribute and the
missing other dimension is derived from the shape's viewBox — the same technique the
[stacksvg](https://github.com/stacksvg/stacksvg) project relies on.
-->

      <h3>{{ if it.inline }}Inline {{ /if }}SVG, sized by viewBox only (stacksvg-style)</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <svg viewBox="0 0 {{ s.width.outer }} {{ s.height.outer }}" width="1.5em">
                <use href="{{ it.useRef }}{{ s.name }}"></use>
              </svg>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>

<!--
Sprite as CSS background image (inline style)
====================================================================================================
The stack sprite may also be used as a CSS background image. The fragment identifier (`#id`) selects
the section to show, just like with `<img>` before. The `:target` pseudo selector reveals the
referenced shape. This variant only works with the stack mode — the other modes don't expose their
shapes this way. Note the `background-repeat: no-repeat` and the `-dims` class that provides the
shape dimensions.
-->

      <h3>Sprite as CSS background image (inline style)</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <div class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}" style="background-image: url('{{ example |> safe }}#{{ s.name }}');"></div>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>

    </section>
