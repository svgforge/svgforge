{{ import { figcaption } from "figcaption.vto" }}{{ layout "layout.vto" }}
{{ slot docTitle }}SVG &lt;defs&gt; sprite preview | svgforge{{ /slot }}
{{ slot header }}<h1>SVG <code>&lt;defs&gt;</code> sprite preview ({{ if it.inline }}inline{{ else }}external{{ /if }})</h1>
      <p>This preview features the use of the generated sprite. Please have a look at the HTML source for further details and be aware of the following constraints:</p>{{ /slot }}
{{ slot hints }}<li>Your browser has to <a href="https://caniuse.com/svg-html5" target="_blank" rel="noopener noreferrer">support SVG in HTML</a> for these techniques to work.</li>{{ /slot }}
{{ slot inlineHints }}<li>The embedded sprite slightly differs from the generated external one. Please <a href="https://github.com/svgforge/svgforge/blob/main/docs/configuration.md#defs--symbol-mode" target="_blank" rel="noopener noreferrer">see the documentation</a> for details on how to create such an embeddable sprite.</li>{{ /slot }}
{{ slot embedded }}
<!--
Inline <defs> SVG sprite
====================================================================================================
This is an inlined version of the generated SVG sprite. The single images may be <use>d everywhere
below within this document. Please see

  https://github.com/svgforge/svgforge/blob/main/docs/configuration.md#defs--symbol-mode

for further details on how to create this embeddable sprite variant.
-->

<svg width="0" height="0" style="position:absolute">
  <defs>
{{ for s of shapes }}
    {{ s.svg |> safe }}
{{ /for }}
  </defs>
</svg>
{{ /slot }}
    <section>

<!--
{{ if it.inline }}Inline {{ /if }}SVG with <use> references
====================================================================================================
These SVG images reference the sprite either by URL + fragment identifier (external sprite) or by a
document-internal ID (embedded sprite). They may be styled via CSS.
-->

      <h3>{{ if it.inline }}Inline {{ /if }}SVG with <code>&lt;use&gt;</code> references</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <svg viewBox="0 0 {{ s.width.outer }} {{ s.height.outer }}" class="{{ for d of s.selector.dimensions }}{{ if d.last }}{{ classname(d.raw) }}{{ /if }}{{ /for }}">
                <use href="{{ it.useRef }}{{ s.name }}"></use>
              </svg>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>
    </section>
    <section>

<!--
{{ if it.inline }}Inline {{ /if }}SVG, sized by viewBox only (stacksvg-style)
====================================================================================================
This method needs no CSS at all: the SVG is sized by a single `width` (or `height`) attribute and the
missing other dimension is derived from the shape's viewBox — the same technique the
[stacksvg](https://github.com/stacksvg/stacksvg) project relies on.
-->

      <h3>{{ if it.inline }}Inline {{ /if }}SVG, sized by viewBox only (stacksvg-style)</h3>
      <ul class="grid">
{{ for s of shapes }}
        <li title="{{ s.name }}">
          <figure>
            <div class="icon-box">
              <svg viewBox="0 0 {{ s.width.outer }} {{ s.height.outer }}" width="1.5em">
                <use href="{{ it.useRef }}{{ s.name }}"></use>
              </svg>
            </div>
            {{ figcaption(s) }}
          </figure>
        </li>
{{ /for }}
      </ul>
    </section>
